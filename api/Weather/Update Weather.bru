meta {
  name: Update Weather
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/weather
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "current": {
      "icon": "w_clear_day",
      "temp": 22,
      "temp_min": 16,
      "temp_max": 29,
      "humidity": 50
    },
    "forecast": [
      { "day": "LUN", "icon": "w_partly_day", "temp_min": 14, "temp_max": 23 },
      { "day": "MAR", "icon": "w_rain", "temp_min": 10, "temp_max": 17 },
      { "day": "MER", "icon": "w_cloudy", "temp_min": 11, "temp_max": 18 },
      { "day": "JEU", "icon": "w_clear_day", "temp_min": 14, "temp_max": 26 },
      { "day": "VEN", "icon": "w_cloudy", "temp_min": 10, "temp_max": 19 },
      { "day": "SAM", "icon": "w_partly_day", "temp_min": 15, "temp_max": 28 }
    ],
    "today": {
      "hours": [
        { "h": 15, "temp": 22, "pop": 0,  "precip": 0 },
        { "h": 16, "temp": 23, "pop": 10, "precip": 2 },
        { "h": 17, "temp": 23, "pop": 40, "precip": 8 },
        { "h": 18, "temp": 21, "pop": 80, "precip": 25 },
        { "h": 19, "temp": 19, "pop": 30, "precip": 4 },
        { "h": 20, "temp": 18, "pop": 10, "precip": 0 },
        { "h": 21, "temp": 17, "pop": 0,  "precip": 0 },
        { "h": 22, "temp": 16, "pop": 0,  "precip": 0 },
        { "h": 23, "temp": 16, "pop": 0,  "precip": 0 },
        { "h": 0,  "temp": 15, "pop": 10, "precip": 0 },
        { "h": 1,  "temp": 15, "pop": 10, "precip": 1 },
        { "h": 2,  "temp": 14, "pop": 20, "precip": 2 }
      ],
      "segments": [
        { "from": 15, "to": 16, "icon": "w_partly_day" },
        { "from": 17, "to": 19, "icon": "w_rain" },
        { "from": 20, "to": 2,  "icon": "w_clear_night" }
      ]
    }
  }
}

docs {
  Updates the WeatherClock with current conditions and forecast, and the
  WeatherToday app with the hourly window.

  The WeatherClock is a system app that displays current weather, time,
  date, and a paginated forecast (pages of 3 columns, auto-scrolling).

  The WeatherToday app displays the hourly window sent in "today": a
  temperature curve, precipitation bars and sky segments. It joins the
  rotation on the first payload carrying a non-empty "today.hours" array.
  Hours are absolute local hours and are displayed as received, so the
  sender decides where the window starts.

  Data older than 1 hour is considered stale and the display falls back
  to a simple clock.

  Parameters:
  - current.icon: Icon name (built-in: w_clear_day, w_rain, w_snow, etc.)
  - current.temp: Current temperature (integer)
  - current.temp_min: Today's min temperature
  - current.temp_max: Today's max temperature
  - current.humidity: Humidity percentage
  - forecast[]: Array of up to 7 forecast days
  - forecast[].day: Day abbreviation (3 chars, e.g. "LUN", "MAR")
  - forecast[].icon: Icon name
  - forecast[].temp_min: Min temperature
  - forecast[].temp_max: Max temperature
  - today.hours[]: Up to 12 hourly entries, extra ones are ignored
  - today.hours[].h: Local hour, 0-23
  - today.hours[].temp: Temperature for that hour (integer)
  - today.hours[].pop: Precipitation probability, 0-100
  - today.hours[].precip: Quantity in tenths of mm (2 = 0.2 mm)
  - today.segments[]: Up to 4 sky segments, extra ones are ignored
  - today.segments[].from: First hour of the segment, inclusive
  - today.segments[].to: Last hour of the segment, inclusive
  - today.segments[].icon: Icon name for the whole segment
}
